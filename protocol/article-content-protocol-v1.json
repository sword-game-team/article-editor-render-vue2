      "resourceQuestion": {
        "$id": "urn:article-content-protocol:resource-question:v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "attrs"
        ],
        "properties": {
          "type": {
            "const": "resourceQuestion"
          },
