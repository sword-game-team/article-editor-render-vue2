{
  "fileFormat": "article-content-protocol",
  "fileFormatVersion": 1,
  "mediaType": "application/vnd.article-content-protocol+json",
  "id": "article-content-v1-with-extensions",
  "version": 1,
  "name": "Article Content Protocol v1 + Extensions",
  "status": "draft",
  "rootNode": "doc",
  "nodes": [
    {
      "type": "doc",
      "kind": "root",
      "description": "Document root; render its children without adding a semantic element.",
      "contentModel": "block*",
      "attributes": [],
      "render": {
        "mode": "fragment"
      }
    },
    {
      "type": "paragraph",
      "kind": "block",
      "description": "A paragraph of inline text.",
      "contentModel": "text*",
      "attributes": [
        {
          "name": "textAlign",
          "type": "string",
          "required": false,
          "description": "Block text alignment. When omitted, use the renderer's default alignment.",
          "allowedValues": [
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        {
          "name": "anchorId",
          "type": "string",
          "required": false,
          "description": "Stable paragraph/heading anchor, unique within the article."
        },
        {
          "name": "fontSize",
          "type": "integer",
          "required": false,
          "description": "Applied to paragraph.attrs.fontSize alongside the unchanged v1 paragraph attributes. Omit to inherit the default size. Consumers must support this optional extension.",
          "minimum": 8,
          "maximum": 96
        }
      ],
      "render": {
        "mode": "element",
        "element": "p",
        "styleBindings": {
          "textAlign": "text-align",
          "fontSize": "font-size"
        },
        "styleUnits": {
          "fontSize": "px"
        },
        "attributeBindings": {
          "anchorId": "data-anchor-id"
        }
      }
    },
    {
      "type": "heading",
      "kind": "block",
      "description": "A semantic heading from h1 through h6.",
      "contentModel": "text*",
      "attributes": [
        {
          "name": "level",
          "type": "integer",
          "required": true,
          "description": "Semantic heading level.",
          "allowedValues": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "minimum": 1,
          "maximum": 6
        },
        {
          "name": "textAlign",
          "type": "string",
          "required": false,
          "description": "Block text alignment. When omitted, use the renderer's default alignment.",
          "allowedValues": [
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        {
          "name": "anchorId",
          "type": "string",
          "required": false,
          "description": "Stable paragraph/heading anchor, unique within the article."
        }
      ],
      "render": {
        "mode": "dynamic-element",
        "attribute": "level",
        "prefix": "h",
        "allowedElements": [
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6"
        ],
        "styleBindings": {
          "textAlign": "text-align"
        },
        "attributeBindings": {
          "anchorId": "data-anchor-id"
        }
      }
    },
    {
      "type": "blockquote",
      "kind": "block",
      "description": "A quoted group of block nodes.",
      "contentModel": "block+",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "blockquote"
      }
    },
    {
      "type": "bulletList",
      "kind": "block",
      "description": "An unordered list.",
      "contentModel": "listItem+",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "ul"
      }
    },
    {
      "type": "orderedList",
      "kind": "block",
      "description": "An ordered list with a one-based start value.",
      "contentModel": "listItem+",
      "attributes": [
        {
          "name": "start",
          "type": "integer",
          "required": true,
          "description": "First visible list number.",
          "defaultValue": 1,
          "minimum": 1
        }
      ],
      "render": {
        "mode": "element",
        "element": "ol",
        "attributeBindings": {
          "start": "start"
        }
      }
    },
    {
      "type": "listItem",
      "kind": "block",
      "description": "A list item containing one or more block nodes.",
      "contentModel": "block+",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "li"
      }
    },
    {
      "type": "codeBlock",
      "kind": "block",
      "description": "A preformatted code block with an optional language identifier.",
      "contentModel": "text?",
      "attributes": [
        {
          "name": "language",
          "type": "string",
          "required": false,
          "description": "Lowercase language identifier used for syntax highlighting."
        }
      ],
      "render": {
        "mode": "element",
        "element": "pre",
        "contentElement": "code",
        "attributeBindings": {
          "language": "data-language"
        }
      }
    },
    {
      "type": "horizontalRule",
      "kind": "block",
      "description": "A thematic break.",
      "contentModel": "none",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "hr",
        "void": true
      }
    },
    {
      "type": "image",
      "kind": "block",
      "description": "A block image with optional horizontal alignment in the article content column.",
      "contentModel": "none",
      "attributes": [
        {
          "name": "src",
          "type": "string",
          "required": true,
          "description": "Image URL or relative path."
        },
        {
          "name": "alt",
          "type": "string",
          "required": false,
          "description": "Alternative text."
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "Optional image title."
        },
        {
          "name": "width",
          "type": "integer",
          "required": false,
          "description": "Intrinsic width in pixels.",
          "minimum": 1,
          "maximum": 10000
        },
        {
          "name": "height",
          "type": "integer",
          "required": false,
          "description": "Intrinsic height in pixels.",
          "minimum": 1,
          "maximum": 10000
        },
        {
          "name": "imageAlign",
          "type": "string",
          "required": false,
          "description": "Horizontal image alignment. Renderers must use a layout container; omission means center.",
          "defaultValue": "center",
          "allowedValues": [
            "left",
            "center",
            "right"
          ]
        },
        {
          "name": "imageLayout",
          "type": "string",
          "required": false,
          "description": "Applied to image.attrs.imageLayout. Adjacent two-column images flow two per row in document order. Other blocks break the row. Omit for the original full-row image layout.",
          "allowedValues": [
            "two-column"
          ]
        }
      ],
      "render": {
        "mode": "element",
        "element": "img",
        "void": true,
        "attributeBindings": {
          "src": "src",
          "alt": "alt",
          "title": "title",
          "width": "width",
          "height": "height",
          "imageAlign": "data-image-align",
          "imageLayout": "data-image-layout"
        },
        "layoutNotes": [
          "Constrain display width to the container. When width and height are supplied, scale height proportionally; do not crop the image. Preserve the original dimensions in JSON.",
          "Adjacent sibling images with imageLayout=two-column occupy half a row each, with a gap. Every two images wrap; intervening non-image blocks start a new row. Omit imageLayout for a full-row container.",
          "imageAlign controls horizontal alignment inside the image layout container; omission means center."
        ]
      }
    },
    {
      "type": "articleButton",
      "kind": "block",
      "description": "An article action displayed with its text. Link actions may omit the business id.",
      "contentModel": "none",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": false,
          "description": "Business identifier used by the consuming application. Required for text and button styles; optional for link style."
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "Descriptive title or tooltip."
        },
        {
          "name": "text",
          "type": "string",
          "required": true,
          "description": "Visible button text."
        },
        {
          "name": "style",
          "type": "string",
          "required": true,
          "description": "Controlled variant: text is a text-like action, button is a button-like action, and link is a hyperlink action.",
          "allowedValues": [
            "text",
            "button",
            "link"
          ]
        },
        {
          "name": "href",
          "type": "string",
          "required": false,
          "description": "Optional link destination. This attribute may only be present when style is link."
        }
      ],
      "constraints": [
        {
          "name": "link-style-href",
          "description": "The optional href attribute may only be present when style is link."
        },
        {
          "name": "non-link-style-id",
          "description": "The id attribute is required when style is text or button, and optional when style is link."
        }
      ],
      "render": {
        "mode": "element",
        "element": "button",
        "textBinding": "text",
        "elementVariants": {
          "attribute": "style",
          "values": {
            "link": "a"
          }
        },
        "attributeBindings": {
          "id": "data-article-button-id",
          "title": "title",
          "style": "data-article-button-style",
          "href": "href"
        }
      }
    },
    {
      "type": "table",
      "kind": "table",
      "description": "A basic semantic table without presentation attributes.",
      "contentModel": "tableRow+",
      "attributes": [],
      "constraints": [
        {
          "name": "uniform-table-columns",
          "description": "Every tableRow in the same table must contain the same number of tableCell nodes."
        }
      ],
      "render": {
        "mode": "element",
        "element": "table"
      }
    },
    {
      "type": "tableRow",
      "kind": "table",
      "description": "A table row.",
      "contentModel": "tableCell+",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "tr"
      }
    },
    {
      "type": "tableCell",
      "kind": "table",
      "description": "A table cell containing block nodes. v1 does not distinguish header cells.",
      "contentModel": "block+",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "td"
      }
    },
    {
      "type": "text",
      "kind": "inline",
      "description": "A text leaf; escape its value before producing HTML.",
      "contentModel": "none",
      "attributes": [],
      "render": {
        "mode": "text"
      }
    },
    {
      "type": "resourceQuestion",
      "description": "Top-level resource question snapshot. Rendering never fetches resource data.",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "description": "See documentSchema.definitions.resourceQuestion.properties.attrs.properties.id"
        },
        {
          "name": "resourceId",
          "type": "string",
          "required": true,
          "description": "See documentSchema.definitions.resourceQuestion.properties.attrs.properties.resourceId"
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "description": "See documentSchema.definitions.resourceQuestion.properties.attrs.properties.title"
        },
        {
          "name": "description",
          "type": "string",
          "required": true,
          "description": "See documentSchema.definitions.resourceQuestion.properties.attrs.properties.description"
        },
        {
          "name": "options",
          "type": "array",
          "required": true,
          "description": "See documentSchema.definitions.resourceQuestion.properties.attrs.properties.options"
        },
        {
          "name": "hideFollowing",
          "type": "boolean",
          "required": true,
          "description": "See documentSchema.definitions.resourceQuestion.properties.attrs.properties.hideFollowing"
        },
        {
          "name": "revealKey",
          "type": "string",
          "required": true,
          "description": "See documentSchema.definitions.resourceQuestion.properties.attrs.properties.revealKey"
        }
      ],
      "render": {
        "mode": "component",
        "element": "resource-question"
      }
    }
  ],
  "marks": [
    {
      "type": "bold",
      "description": "Strong importance.",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "strong"
      }
    },
    {
      "type": "italic",
      "description": "Emphasized text.",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "em"
      }
    },
    {
      "type": "strike",
      "description": "Deleted or no-longer-valid text.",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "s"
      }
    },
    {
      "type": "underline",
      "description": "Underlined text.",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "u"
      }
    },
    {
      "type": "code",
      "description": "Inline code.",
      "attributes": [],
      "render": {
        "mode": "element",
        "element": "code"
      }
    },
    {
      "type": "link",
      "description": "An href or application-defined custom link.",
      "attributes": [
        {
          "name": "type",
          "type": "string",
          "required": false,
          "description": "Link destination type. Omission means href for legacy documents.",
          "defaultValue": "href",
          "allowedValues": [
            "href",
            "custom"
          ]
        },
        {
          "name": "href",
          "type": "string",
          "required": false,
          "description": "Required only for href links. Renderers must validate and escape this URI reference."
        },
        {
          "name": "id",
          "type": "string",
          "required": false,
          "description": "Application-defined identifier required only for custom links."
        },
        {
          "name": "title",
          "type": "string",
          "required": false,
          "description": "Application-defined title required only for custom links."
        },
        {
          "name": "target",
          "type": "string",
          "required": true,
          "description": "Browsing context.",
          "defaultValue": "_blank",
          "allowedValues": [
            "_blank",
            "_self"
          ]
        }
      ],
      "constraints": [
        {
          "name": "href-link-fields",
          "description": "An href link requires href and must not contain id or title. A missing type is treated as href."
        },
        {
          "name": "custom-link-fields",
          "description": "A custom link requires type=custom, id, and title, and must not contain href."
        }
      ],
      "render": {
        "mode": "element",
        "element": "a",
        "attributeBindings": {
          "type": "data-link-type",
          "href": "href",
          "id": "data-link-id",
          "title": "title",
          "target": "target"
        }
      }
    },
    {
      "type": "textStyle",
      "description": "Text foreground color.",
      "attributes": [
        {
          "name": "color",
          "type": "string",
          "required": true,
          "description": "A six-digit hexadecimal CSS color, including the leading #.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      ],
      "render": {
        "mode": "element",
        "element": "span",
        "styleBindings": {
          "color": "color"
        }
      }
    },
    {
      "type": "highlight",
      "description": "Text background highlight color.",
      "attributes": [
        {
          "name": "color",
          "type": "string",
          "required": true,
          "description": "A six-digit hexadecimal CSS color, including the leading #.",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      ],
      "render": {
        "mode": "element",
        "element": "mark",
        "styleBindings": {
          "color": "background-color"
        }
      }
    }
  ],
  "documentSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "urn:article-content-protocol:v1:with-formatting-extensions",
    "title": "Article Content Protocol v1 + Extensions",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "type",
      "content"
    ],
    "properties": {
      "type": {
        "const": "doc"
      },
      "content": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "$ref": "#/definitions/blockNode"
            },
            {
              "$ref": "#/definitions/resourceQuestion"
            }
          ]
        }
      }
    },
    "definitions": {
      "blockNode": {
        "oneOf": [
          {
            "$ref": "#/definitions/paragraph"
          },
          {
            "$ref": "#/definitions/heading"
          },
          {
            "$ref": "#/definitions/blockquote"
          },
          {
            "$ref": "#/definitions/bulletList"
          },
          {
            "$ref": "#/definitions/orderedList"
          },
          {
            "$ref": "#/definitions/codeBlock"
          },
          {
            "$ref": "#/definitions/horizontalRule"
          },
          {
            "$ref": "#/definitions/image"
          },
          {
            "$ref": "#/definitions/articleButton"
          },
          {
            "$ref": "#/definitions/table"
          }
        ]
      },
      "paragraph": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "paragraph"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "textAlign": {
                "$ref": "#/definitions/textAlign"
              },
              "fontSize": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "$id": "urn:article-content-protocol:paragraph-font-size:v1",
                "title": "Optional paragraph fontSize attribute (pixels)",
                "description": "Applied to paragraph.attrs.fontSize alongside the unchanged v1 paragraph attributes. Omit to inherit the default size. Consumers must support this optional extension.",
                "type": "integer",
                "minimum": 8,
                "maximum": 96
              },
              "anchorId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Stable paragraph/heading anchor, unique within the article."
              }
            }
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/text"
            }
          }
        }
      },
      "heading": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "attrs"
        ],
        "properties": {
          "type": {
            "const": "heading"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level"
            ],
            "properties": {
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "textAlign": {
                "$ref": "#/definitions/textAlign"
              },
              "anchorId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Stable paragraph/heading anchor, unique within the article."
              }
            }
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/text"
            }
          }
        }
      },
      "blockquote": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "content"
        ],
        "properties": {
          "type": {
            "const": "blockquote"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/blockNode"
            }
          }
        }
      },
      "bulletList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "content"
        ],
        "properties": {
          "type": {
            "const": "bulletList"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/listItem"
            }
          }
        }
      },
      "orderedList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "attrs",
          "content"
        ],
        "properties": {
          "type": {
            "const": "orderedList"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/listItem"
            }
          }
        }
      },
      "listItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "content"
        ],
        "properties": {
          "type": {
            "const": "listItem"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/blockNode"
            }
          }
        }
      },
      "codeBlock": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "attrs"
        ],
        "properties": {
          "type": {
            "const": "codeBlock"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "language": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            }
          },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "text"
              ],
              "properties": {
                "type": {
                  "const": "text"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "horizontalRule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "const": "horizontalRule"
          }
        }
      },
      "image": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "attrs"
        ],
        "properties": {
          "type": {
            "const": "image"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src"
            ],
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "imageAlign": {
                "$ref": "#/definitions/imageAlign"
              },
              "imageLayout": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "$id": "urn:article-content-protocol:image-layout:v1",
                "title": "Optional two-column image layout",
                "description": "Applied to image.attrs.imageLayout. Adjacent two-column images flow two per row in document order. Other blocks break the row. Omit for the original full-row image layout.",
                "type": "string",
                "enum": [
                  "two-column"
                ]
              }
            }
          }
        }
      },
      "articleButton": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "attrs"
        ],
        "properties": {
          "type": {
            "const": "articleButton"
          },
          "attrs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "style"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "style": {
                "enum": [
                  "text",
                  "button",
                  "link"
                ]
              },
              "href": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "style": {
                      "enum": [
                        "text",
                        "button"
                      ]
                    }
                  },
                  "required": [
                    "style"
                  ]
                },
                "then": {
                  "properties": {
                    "id": {}
                  },
                  "required": [
                    "id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "href": {}
                  },
                  "required": [
                    "href"
                  ]
                },
                "then": {
                  "properties": {
                    "style": {
                      "const": "link"
                    }
                  }
                }
              }
            ]
          }
        }
